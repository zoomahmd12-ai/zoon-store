.sidebar a.nav:hover, .sidebar button.nav:hover { background:var(--gold); color:#000; }
.overlay { position:fixed; inset:0; background:rgba(0,0,0,.7); z-index:150; display:none; }
.overlay.show { display:block; }
.container { max-width:900px; margin:0 auto; padding:15px; }
.hero { background:linear-gradient(135deg,#1a1a1a,#000); border:2px solid var(--gold); border-radius:16px; padding:30px 20px; text-align:center; margin-bottom:20px; }
.hero h1 { color:var(--gold); font-size:26px; margin-bottom:10px; }
.hero p { color:#ccc; font-size:15px; }
.grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:12px; }
.game-card { background:var(--card); border:1px solid #333; border-radius:14px; overflow:hidden; cursor:pointer; }
.game-card:hover { border-color:var(--gold); }
.game-card img { width:100%; height:130px; object-fit:cover; display:block; }
.game-card .title { padding:10px; text-align:center; font-weight:bold; color:var(--gold); }
.section-title { color:var(--gold); font-size:20px; margin:20px 0 12px; border-right:4px solid var(--gold); padding-right:10px; }
.offer-card { background:var(--card); border:1px solid #333; border-radius:12px; padding:15px; display:flex; flex-direction:column; gap:8px; }
.offer-card .name { font-weight:bold; color:#fff; font-size:15px; }
.offer-card .price { color:var(--gold); font-size:18px; font-weight:bold; }
.btn { background:linear-gradient(135deg,var(--gold),var(--gold2)); color:#000; border:none; padding:12px; border-radius:10px; font-weight:bold; font-size:15px; width:100%; }
.btn:hover { opacity:.9; }
.btn-outline { background:none; border:2px solid var(--gold); color:var(--gold); }
.btn-danger { background:#c0392b; color:#fff; }
.btn-ok { background:#27ae60; color:#fff; }
.btn-sm { padding:7px 11px; font-size:13px; width:auto; }
.form-box { background:var(--card); border:1px solid #333; border-radius:14px; padding:20px; max-width:420px; margin:20px auto; }
.form-box.wide { max-width:100%; }
.form-box h2 { color:var(--gold); text-align:center; margin-bottom:20px; }
.form-group { margin-bottom:14px; }
.form-group label { display:block; margin-bottom:6px; color:#ccc; font-size:14px; }
.inp, .form-group input, .form-group select { width:100%; padding:12px; background:#0a0a0a; border:1px solid #333; border-radius:8px; color:#fff; font-size:15px; }
.inp:focus, .form-group input:focus { outline:none; border-color:var(--gold); }
select.inp option { background:#0a0a0a; }
.switch-link { text-align:center; margin-top:15px; font-size:14px; color:#888; }
.tbl-wrap { overflow-x:auto; }
table { width:100%; border-collapse:collapse; background:var(--card); border-radius:12px; overflow:hidden; margin-top:10px; }
th, td { padding:10px; text-align:right; border-bottom:1px solid #333; font-size:13px; }
th { background:#0a0a0a; color:var(--gold); white-space:nowrap; }
.status { padding:3px 8px; border-radius:6px; font-size:12px; font-weight:bold; white-space:nowrap; }
.status.pending { background:#f39c12; color:#000; }
.status.approved { background:#27ae60; color:#fff; }
.status.rejected { background:#c0392b; color:#fff; }
.toast { position:fixed; bottom:90px; left:50%; transform:translateX(-50%); background:var(--gold); color:#000; padding:14px 24px; border-radius:10px; font-weight:bold; z-index:999; max-width:90%; text-align:center; display:none; }
.modal { position:fixed; inset:0; background:rgba(0,0,0,.85); z-index:300; display:none; align-items:center; justify-content:center; padding:15px; }
.modal.show { display:flex; }
.modal-content { background:var(--card); border:2px solid var(--gold); border-radius:16px; padding:20px; max-width:450px; width:100%; max-height:90vh; overflow-y:auto; }
.modal-content h3 { color:var(--gold); margin-bottom:15px; text-align:center; }
.bottom-nav { position:fixed; bottom:0; left:0; right:0; background:var(--dark); border-top:2px solid var(--gold); display:flex; justify-content:space-around; padding:8px 0; z-index:99; }
