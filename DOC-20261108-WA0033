    if(!confirm('حذف بيانات ' + u.name + ' من المتجر؟ (حساب الدخول نفسه بيضل موجود بـ Firebase Authentication)')) return;
    db.collection('users').doc(id).delete().then(function(){ return adminDone('تم الحذف'); }).catch(adminErr);
  },
  addgame: function(){
    var n = $('agName').value.trim(); if(!n) return toast('اكتب اسم اللعبة');
