if(FB_ERR){ var w = $('fbWarn'); w.textContent = '⚠️ ' + FB_ERR; w.style.display = 'block'; }
updateHeader();
if(!auth) showPage(location.hash === ADMIN_HASH ? 'adminlogin' : 'login');
})();
