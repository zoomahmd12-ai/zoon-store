function loadAddons(catId){
  currentCat = catId;
  var list = D.addons.filter(function(a){ return a.category === catId; });
  $('addonsContainer').innerHTML = '<h3 class="section-title" style="font-size:16px;">الباقات</h3><div class="grid">' +
    (list.map(function(a){
      return '<div class="offer-card"><div class="name">' + esc(a.name) + '</div><div class="price">' + fmt(a.price) + '</div><button class="btn" data-act="buy" data-id="' + esc(a.id) + '">اطلب هلا</button></div>';
    }).join('') || '<div class="empty">لا توجد باقات</div>') + '</div>';
}
function openOrderModal(addonId){
  if(!ME) return;
  var last = 0; try { last = parseInt(localStorage.getItem(LKEY) || '0', 10) || 0; } catch(e){}
  var diff = Date.now() - last;
  if(diff < 60000) return toast('⏳ لازم تنتظر ' + Math.ceil((60000 - diff) / 1000) + ' ثانية قبل طلب جديد');
  var a = byId(D.addons, addonId); if(!a) return toast('الباقة غير موجودة');
  openModal('<div class="modal-content"><h3>' + esc(a.name) + '</h3>' +
    '<div style="text-align:center; color:var(--gold); font-size:24px; margin:10px 0;">' + fmt(a.price) + '</div>' +
    '<div class="form-group"><label>ID اللاعب</label><input type="text" id="playerId" placeholder="ادخل ID" maxlength="60"></div>' +
    '<div style="text-align:center; color:#888; margin-bottom:12px;">رصيدك: <b style="color:var(--gold);">' + fmt(ME.balance) + '</b></div>' +
    '<button class="btn" data-act="confirm" data-id="' + esc(addonId) + '">تأكيد الطلب</button>' +
    '<button class="btn btn-outline" style="margin-top:8px;" data-act="closemodal">إلغاء</button></div>');
}
var ordering = false;
function placeOrder(addonId){
  if(!ME || needFb() || ordering) return;
  var pid = $('playerId').value.trim();
  if(!pid) return toast('ادخل ID');
  var a = byId(D.addons, addonId); if(!a) return toast('الباقة غير موجودة');
  var cat = byId(D.categories, a.category), game = cat ? byId(D.games, cat.game) : null;
  var uRef = db.collection('users').doc(ME.uid), aRef = db.collection('addons').doc(addonId), oRef = db.collection('orders').doc();
  ordering = true;
  db.runTransaction(function(t){
    return Promise.all([t.get(uRef), t.get(aRef)]).then(function(r){
      var u = r[0].data(), ad = r[1].exists ? r[1].data() : null;
      if(!ad) throw new Error('الباقة غير موجودة');
      var price = Number(ad.price);
      if(!(price > 0)) throw new Error('سعر غير صحيح');
      if(Number(u.balance) < price) throw new Error('رصيدك ما بيكفي');
      t.update(uRef, { balance: u.balance - price, totalOut: u.totalOut + price, lastOrderId: oRef.id });
      t.set(oRef, {
        userId: ME.uid, userName: u.name, userPhone: u.phone, gameName: game ? game.name : currentGameName,
        addonId: addonId, addonName: ad.name, playerId: pid, price: price, status: 'pending', date: FV.serverTimestamp()
      });
    });
  }).then(function(){
    ordering = false;
    try { localStorage.setItem(LKEY, String(Date.now())); } catch(e){}
    closeModal(); toast('✅ تم الطلب بنجاح');
  }).catch(function(e){ ordering = false; console.error(e); toast(e.code === 'permission-denied' ? '❌ تعذر تنفيذ الطلب (راجع قواعد Firestore)' : '❌ ' + (e.message || e.code), 5000); });
}
function fetchMyOrders(){
  return db.collection('orders').where('userId', '==', ME.uid).get().then(function(s){
    return s.docs.map(toObj).sort(function(a, b){ return ms(b.date) - ms(a.date); });
  });
}
var ST = { pending:'قيد الانتظار', approved:'تم الشحن', rejected:'مرفوض (انرجع الرصيد)' };
function renderOrders(){
  var box = $('ordersList'); if(!ME) return;
  box.innerHTML = '<div class="empty">⏳</div>';
  fetchMyOrders().then(function(list){
    if(!list.length){ box.innerHTML = '<div class="empty">لا توجد طلبات</div>'; return; }
    box.innerHTML = '<div class="tbl-wrap"><table><tr><th>التاريخ</th><th>الاضافة</th><th>ID</th><th>السعر</th><th>الحالة</th></tr>' +
      list.map(function(o){
        var st = ST[o.status] ? o.status : 'pending';
        return '<tr><td>' + fmtDate(o.date) + '</td><td>' + esc(o.addonName) + '</td><td>' + esc(o.playerId) + '</td><td>' + fmt(o.price) + '</td><td><span class="status ' + st + '">' + ST[st] + '</span></td></tr>';
      }).join('') + '</table></div>';
  }).catch(function(e){ console.error(e); box.innerHTML = '<div class="empty">تعذر تحميل الطلبات</div>'; });
}
function renderWallet(){
  if(!ME) return;
  $('walletIn').textContent = fmt(ME.totalIn); $('walletOut').textContent = fmt(ME.totalOut); $('walletBal').textContent = fmt(ME.balance);
}
function renderSpent(){
