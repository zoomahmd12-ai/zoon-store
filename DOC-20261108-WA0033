.empty { text-align:center; padding:30px; color:#666; }
.badge { background:var(--gold); color:#000; padding:2px 8px; border-radius:10px; font-size:11px; font-weight:bold; }
.row { display:flex; gap:8px; align-items:center; }
.row > * { flex:1; min-width:0; }
.row > .btn-sm { flex:0 0 auto; }
.meta { font-size:12px; color:#888; margin:8px 0; line-height:1.7; }
.cv-result { margin-top:12px; text-align:center; font-size:20px; font-weight:bold; color:var(--gold); background:#0a0a0a; border:1px dashed var(--gold); border-radius:10px; padding:14px; }
.tabs { display:grid; grid-template-columns:repeat(2,1fr); gap:8px; margin-bottom:16px; }
