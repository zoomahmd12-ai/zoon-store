var ADMIN_ACTS = { admintab:1, userbal:1, deluser:1, ordok:1, ordno:1, addgame:1, delgame:1, addcat:1, delcat:1, addaddon:1, deladdon:1, gencode:1, addbal:1, saverates:1, livetry:1, export:1, seed:1 };
var A = {
  nav: function(id){ nav(id); },
  menu: function(id){ toggleMenu(id === '1'); },
  showpage: function(id){ showPage(id); },
