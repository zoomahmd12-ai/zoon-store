function renderGames(){
  var grid = $('gamesGrid');
  if(!D.games.length){ grid.innerHTML = '<div class="empty">لا توجد ألعاب حالياً</div>'; return; }
  grid.innerHTML = D.games.map(function(g){
    return '<div class="game-card" data-act="game" data-id="' + esc(g.id) + '"><img src="' + esc(safeUrl(g.img) || FALLBACK_IMG) + '" alt=""><div class="title">' + esc(g.name) + '</div></div>';
  }).join('');
}
function openGame(id){
  var g = byId(D.games, id); if(!g) return;
  currentGameName = g.name; currentCat = null;
  $('gameName').textContent = g.name;
  $('gameHero').innerHTML = '<img src="' + esc(safeUrl(g.img) || FALLBACK_IMG) + '" alt="" style="width:100%;height:180px;object-fit:cover;display:block;">';
  var cats = D.categories.filter(function(c){ return c.game === id; });
  $('categoriesGrid').innerHTML = cats.map(function(c){
