    db.collection('games').add({ name: n, img: img }).then(function(){ return adminDone('✅ انضافت اللعبة', true); }).catch(adminErr);
  },
  delgame: function(id){
    if(!confirm('حذف اللعبة مع أقسامها وباقاتها؟')) return;
    var cats = D.categories.filter(function(c){ return c.game === id; }).map(function(c){ return c.id; });
    var b = db.batch();
    D.addons.forEach(function(a){ if(cats.indexOf(a.category) > -1) b.delete(db.collection('addons').doc(a.id)); });
    cats.forEach(function(cid){ b.delete(db.collection('categories').doc(cid)); });
    b.delete(db.collection('games').doc(id));
    b.commit().then(function(){ return adminDone('تم الحذف', true); }).catch(adminErr);
  },
  addcat: function(){
