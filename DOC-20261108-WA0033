function byId(arr, id){ for(var i = 0; i < arr.length; i++) if(arr[i].id === id) return arr[i]; return null; }

/* ================= Firebase ================= */
var auth = null, db = null, FV = null, FB_ERR = '';
try {
  if(typeof firebase === 'undefined') throw new Error('lib');
  firebase.initializeApp(FIREBASE_CONFIG);
  auth = firebase.auth(); db = firebase.firestore(); FV = firebase.firestore.FieldValue;
} catch(e){
  FB_ERR = (e && e.message === 'lib') ? 'تعذر تحميل مكتبة Firebase. تأكد من الانترنت أو جرّب VPN (ممكن تكون محجوبة ببلدك).' : 'خطأ بتهيئة Firebase: ' + (e && e.message);
}
function needFb(){ if(auth && db) return false; toast('❌ ' + FB_ERR, 7000); return true; }
function authMsg(e){
  var m = {
    'auth/invalid-credential': 'ايميل أو كلمة سر غلط، أو ما عندك حساب (سجّل أول)',
    'auth/invalid-login-credentials': 'ايميل أو كلمة سر غلط، أو ما عندك حساب (سجّل أول)',
    'auth/user-not-found': 'ما في حساب بهاد الايميل، سجّل أول',
    'auth/wrong-password': 'كلمة السر غلط',
    'auth/invalid-email': 'صيغة الايميل غلط',
    'auth/email-already-in-use': 'الايميل مستخدم',
    'auth/weak-password': 'كلمة السر ضعيفة (6 أحرف عالأقل)',
    'auth/operation-not-allowed': 'فعّل Email/Password من Firebase ← Authentication ← Sign-in method',
    'auth/unauthorized-domain': 'أضف هاد النطاق بـ Firebase ← Authentication ← Settings ← Authorized domains',
    'auth/network-request-failed': 'مشكلة اتصال بالانترنت',
    'auth/too-many-requests': 'محاولات كتير، انتظر شوي',
    'auth/operation-not-supported-in-this-environment': 'افتح الصفحة من localhost أو من استضافة، مو بالضغط المزدوج على الملف',
    'permission-denied': 'ما في صلاحية (راجع قواعد Firestore)'
  };
  return '❌ ' + (m[e && e.code] || ((e && (e.code || e.message)) || 'خطأ'));
}

/* ================= الحالة ================= */
var ME = null, isAdmin = false, unsubUser = null, registering = false, wantAdmin = false;
var D = { users: [], orders: [], codes: [], games: [], categories: [], addons: [] };
var RATES = JSON.parse(JSON.stringify(DEF_RATES)), RATES_UPDATED = 0;
var CURSEL = 'USD'; try { var cs = localStorage.getItem(CKEY); if(cs && CUR[cs]) CURSEL = cs; } catch(e){}
var currentPage = 'login', currentCat = null, currentGameName = '', adminTab = 'dashboard';

function rate(c){ var r = Number(RATES[c]); return r > 0 ? r : (DEF_RATES[c] || 1); }
function fmt(cents){
  var info = CUR[CURSEL], v = Number(cents || 0) / 100 * rate(CURSEL), s = numf(v, info[2]);
  return CURSEL === 'USD' ? '$' + s : s + ' ' + info[3];
}

/* ================= واجهة عامة ================= */
function toast(msg, dur){
  var t = $('toast'); t.textContent = msg; t.style.display = 'block';
  clearTimeout(t._tm); t._tm = setTimeout(function(){ t.style.display = 'none'; }, dur || 2800);
}
function toggleMenu(open){ $('sidebar').classList.toggle('open', open); $('overlay').classList.toggle('show', open); }
function showPage(p){
  currentPage = p;
  document.body.classList.toggle('adm', p === 'admin' || p === 'adminlogin');
  document.querySelectorAll('.page').forEach(function(el){ el.classList.remove('active'); });
  var el = $('page-' + p); if(el) el.classList.add('active');
  window.scrollTo(0, 0);
}
function openModal(html){ $('modalBox').innerHTML = html; $('modalBox').classList.add('show'); }
function closeModal(){ $('modalBox').classList.remove('show'); }
function updateHeader(){
  $('mainHeader').style.display = ME ? 'flex' : 'none';
  $('bottomNav').style.display = ME ? 'flex' : 'none';
  if(ME) $('headerBalance').textContent = fmt(ME.balance);
  $('curLabel').textContent = CURSEL;
}
function rerender(){
  var p = currentPage;
  if(p === 'home') renderGames();
  else if(p === 'orders') renderOrders();
  else if(p === 'wallet') renderWallet();
  else if(p === 'spent') renderSpent();
  else if(p === 'share') renderShare();
  else if(p === 'rates') renderRates();
  else if(p === 'admin') renderAdmin();
  else if(p === 'game' && currentCat) loadAddons(currentCat);
}
function nav(p){
  toggleMenu(false); closeModal();
  if(!ME && p !== 'login' && p !== 'register'){ showPage('login'); return; }
  if(p === 'admin'){ openAdminGate(); return; }
  document.querySelectorAll('.bottom-nav button').forEach(function(b){ b.classList.toggle('active', b.dataset.nav === p); });
  showPage(p);
  rerender();
}

/* ================= الحسابات ================= */
function loadCatalog(){
  return Promise.all([
    db.collection('games').get(), db.collection('categories').get(), db.collection('addons').get(),
    db.collection('settings').doc('rates').get()
  ]).then(function(r){
    D.games = r[0].docs.map(toObj); D.categories = r[1].docs.map(toObj); D.addons = r[2].docs.map(toObj);
    var s = r[3].exists ? r[3].data() : null;
    if(s && s.rates){ RATES = Object.assign({}, DEF_RATES, s.rates); RATES_UPDATED = ms(s.updatedAt); }
  });
}
function afterLogin(){
  updateHeader();
  loadCatalog().catch(function(e){ console.error(e); toast('تعذر تحميل البيانات (راجع قواعد Firestore)', 5000); }).then(function(){
    var wantsPanel = wantAdmin || location.hash === ADMIN_HASH;
    wantAdmin = false;
    if(wantsPanel){
      if(isAdmin){ openAdmin(); return; }
      toast('⛔ هاد الحساب ما عنده صلاحية إدارة', 4000);
    }
    nav('home');
  });
}
function healUser(user){
  // حساب موجود بـ Auth بس ما إله ملف بـ Firestore (مثلاً انقطع التسجيل): منعمل له ملف فاضي
  db.collection('users').doc(user.uid).set({
    name: String(user.email || 'user').split('@')[0].slice(0, 60), phone: '', email: user.email || '',
    refCode: 'ZOON' + randCode(6), refBy: null, balance: 0, totalIn: 0, totalOut: 0, createdAt: FV.serverTimestamp()
  }).catch(function(e){ console.error(e); toast(authMsg(e), 6000); });
}
function listenUser(user){
  var first = true;
  unsubUser = db.collection('users').doc(user.uid).onSnapshot(function(d){
    if(!d.exists){ if(!registering) healUser(user); return; }
    ME = d.data({ serverTimestamps: 'estimate' }); ME.uid = user.uid;
    updateHeader();
    if(first){ first = false; afterLogin(); }
    else if(currentPage === 'wallet') renderWallet();
  }, function(err){ console.error(err); toast('❌ تعذر قراءة بيانات الحساب (راجع قواعد Firestore)', 5000); });
}
if(auth){
  auth.onAuthStateChanged(function(user){
    if(unsubUser){ unsubUser(); unsubUser = null; }
    ME = null; isAdmin = false;
    if(!user){ updateHeader(); showPage(location.hash === ADMIN_HASH ? 'adminlogin' : 'login'); return; }
    db.collection('admins').doc(user.uid).get().then(function(d){ isAdmin = d.exists; }, function(){ isAdmin = false; })
      .then(function(){ listenUser(user); });
  });
}

function register(){
  if(needFb()) return;
  var name = $('regName').value.trim();
  var phone = $('regPhone').value.replace(/[^0-9]/g, '');
  var email = $('regEmail').value.trim();
  var pass = $('regPass').value;
  if(!name || !phone || !email || !pass) return toast('عبّي كل الحقول');
  if(pass.length < 6) return toast('كلمة السر 6 أحرف عالاقل');
  var ref = new URLSearchParams(location.search).get('ref');
  if(!ref || !/^[A-Z0-9]{4,16}$/.test(ref)) ref = null;
  registering = true;
  auth.createUserWithEmailAndPassword(email, pass).then(function(cred){
    return db.collection('users').doc(cred.user.uid).set({
      name: name, phone: phone, email: email, refCode: 'ZOON' + randCode(6), refBy: ref,
      balance: 0, totalIn: 0, totalOut: 0, createdAt: FV.serverTimestamp()
    });
  }).then(function(){ registering = false; toast('✅ تم التسجيل!'); })
    .catch(function(e){ registering = false; console.error(e); toast(authMsg(e), 6000); });
}
function login(){
  if(needFb()) return;
  var email = $('loginEmail').value.trim(), pass = $('loginPass').value;
  if(!email || !pass) return toast('عبّي الحقول');
  auth.signInWithEmailAndPassword(email, pass).then(function(){ $('loginPass').value = ''; })
    .catch(function(e){ console.error(e); toast(authMsg(e), 6000); });
}
function logout(){
  toggleMenu(false);
  if(!auth) return;
  auth.signOut().then(function(){ try { history.replaceState(null, '', location.pathname + location.search); } catch(e){} toast('تم تسجيل الخروج'); });
}

/* ================= الرصيد والأكواد ================= */
function redeem(){
  if(!ME || needFb()) return;
  var code = $('redeemCode').value.trim().toUpperCase();
  if(!code) return toast('ادخل الكود');
  if(!/^[A-Z0-9-]{4,30}$/.test(code)) return toast('❌ الكود غير صحيح');
  var cRef = db.collection('codes').doc(code), uRef = db.collection('users').doc(ME.uid);
  db.runTransaction(function(t){
    return Promise.all([t.get(cRef), t.get(uRef)]).then(function(r){
      if(!r[0].exists) throw new Error('الكود غير موجود');
      var c = r[0].data(), u = r[1].data(), v = Number(c.value);
      if(c.phone !== u.phone) throw new Error('هاد الكود مو الك');
      if(c.used) throw new Error('هاد الكود انحرق من قبل');
      if(!(v > 0)) throw new Error('قيمة الكود غير صحيحة');
      t.update(cRef, { used: true, usedBy: ME.uid, usedAt: FV.serverTimestamp() });
      t.update(uRef, { balance: u.balance + v, totalIn: u.totalIn + v, lastCodeId: code });
      return v;
    });
  }).then(function(v){ toast('✅ تم تفعيل الكود: +' + fmt(v)); $('redeemCode').value = ''; })
    .catch(function(e){ console.error(e); toast(e.code === 'permission-denied' ? '❌ الكود غير صالح أو مو الك' : '❌ ' + (e.message || e.code)); });
}
function reqBal(){
  if(!ME) return;
  var msg = 'مرحبا، أنا ' + ME.name + '\nرقمي: ' + ME.phone + '\nالايميل: ' + ME.email + '\nبدي أضيف رصيد لحسابي بمتجر ZOON (دفع كاش).';
  window.open('https://wa.me/' + ADMIN_WA + '?text=' + encodeURIComponent(msg), '_blank');
}

