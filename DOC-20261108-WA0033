  admintab: function(id){ adminTab = id; renderAdmin(); },
  ordok: function(id){
    var o = byId(D.orders, id); if(!o || o.status !== 'pending') return;
    db.collection('orders').doc(id).update({ status: 'approved' }).then(function(){ return adminDone('✅ تم'); }).catch(adminErr);
  },
  ordno: function(id){
    var o = byId(D.orders, id); if(!o || o.status !== 'pending') return;
    if(!confirm('رفض الطلب وإرجاع المبلغ للزبون؟')) return;
    var oRef = db.collection('orders').doc(id), uRef = db.collection('users').doc(o.userId);
    db.runTransaction(function(t){
      return Promise.all([t.get(oRef), t.get(uRef)]).then(function(r){
        var od = r[0].data();
        if(!od || od.status !== 'pending') throw new Error('الطلب مو معلّق');
        t.update(oRef, { status: 'rejected' });
        if(r[1].exists){ var u = r[1].data(); t.update(uRef, { balance: u.balance + od.price, totalOut: Math.max(0, u.totalOut - od.price) }); }
      });
    }).then(function(){ return adminDone('تم الرفض وإرجاع الرصيد'); }).catch(adminErr);
  },
  userbal: function(id){
    var u = byId(D.users, id); if(!u) return;
