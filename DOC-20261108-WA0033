<style>
* { margin:0; padding:0; box-sizing:border-box; font-family:'Tahoma','Segoe UI',sans-serif; }
:root { --gold:#d4af37; --gold2:#f5d76e; --black:#0a0a0a; --dark:#141414; --card:#1c1c1c; }
body { background:var(--black); color:#fff; min-height:100vh; padding-bottom:80px; }
a { color:var(--gold); text-decoration:none; }
button { cursor:pointer; font-family:inherit; }
input, select { font-family:inherit; }
.header { background:linear-gradient(135deg,#000,#1a1a1a); border-bottom:2px solid var(--gold); padding:12px 15px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:100; }
