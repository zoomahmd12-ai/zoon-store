/* ================= أسعار الصرف ================= */
function setCur(c){
  if(!CUR[c]) return;
  CURSEL = c; try { localStorage.setItem(CKEY, c); } catch(e){}
  updateHeader(); rerender(); toast('✅ العملة المعتمدة: ' + c);
}
function fillSelects(){
  var f = $('cvFrom'), t = $('cvTo');
  if(f.options.length) return;
  var opts = Object.keys(CUR).map(function(c){ return '<option value="' + c + '">' + CUR[c][1] + ' ' + c + ' - ' + esc(CUR[c][0]) + '</option>'; }).join('');
  f.innerHTML = opts; t.innerHTML = opts;
  f.value = 'USD'; t.value = CURSEL !== 'USD' ? CURSEL : 'SYP';
}
function renderConverter(){
  var amt = parseFloat($('cvAmount').value), from = $('cvFrom').value, to = $('cvTo').value;
  if(!(amt >= 0)){ $('cvResult').textContent = '—'; return; }
  var v = amt / rate(from) * rate(to);
  $('cvResult').textContent = numf(amt, 2) + ' ' + from + ' = ' + numf(v, v >= 1 ? CUR[to][2] : 4) + ' ' + to;
}
function renderRatesTable(){
  $('ratesTable').innerHTML = '<table><tr><th>العملة</th><th>1$ =</th><th>1 وحدة = $</th><th></th></tr>' +
    Object.keys(CUR).map(function(c){
      var r = rate(c), d = r >= 1000 ? 0 : (r >= 10 ? 2 : 4);
      return '<tr><td>' + CUR[c][1] + ' <b>' + c + '</b><br><span class="small">' + esc(CUR[c][0]) + '</span></td><td>' + numf(r, d) + '</td><td>' + numf(1 / r, 4) + '</td><td>' +
        (c === CURSEL ? '<span class="badge">معتمدة</span>' : '<button class="btn btn-sm" data-act="setcur" data-id="' + c + '">اعتمد</button>') + '</td></tr>';
    }).join('') + '</table>';
}
function renderRates(){
  fillSelects(); renderConverter(); renderRatesTable();
  $('ratesMeta').textContent = RATES_UPDATED ? 'آخر تحديث من الإدارة: ' + new Date(RATES_UPDATED).toLocaleString('ar') : 'الأسعار الحالية افتراضية، الإدارة بتحدّثها.';
}

/* ================= لوحة الأدمن ================= */
function openAdminGate(){
  closeModal(); toggleMenu(false);
  if(ME && isAdmin){ openAdmin(); } else { wantAdmin = true; showPage('adminlogin'); }
}
function openAdmin(){
  if(!(ME && isAdmin)){ showPage('adminlogin'); return; }
  showPage('admin');
  $('adminTabs').innerHTML = '';
  $('adminBody').innerHTML = '<div class="empty">⏳ جاري التحميل...</div>';
  loadAdminData().then(renderAdmin).catch(function(e){ adminErr(e); renderAdmin(); });
}
function admLogin(){
  if(needFb()) return;
  var email = $('admEmail').value.trim(), pass = $('admPass').value;
  if(!email || !pass) return toast('عبّي الحقول');
  wantAdmin = true;
  auth.signInWithEmailAndPassword(email, pass).then(function(cred){
    $('admPass').value = '';
    // إذا نفس الحساب كان داخل أصلاً ما بيجي حدث تغيير مستخدم، فمنفتح اللوحة يدوياً
    if(ME && ME.uid === cred.user.uid){ wantAdmin = false; if(isAdmin) openAdmin(); else toast('⛔ هاد الحساب ما عنده صلاحية إدارة', 4000); }
  }).catch(function(e){ wantAdmin = false; console.error(e); toast(authMsg(e), 6000); });
}
function admExit(){
  wantAdmin = false;
  try { history.replaceState(null, '', location.pathname + location.search); } catch(e){}
  if(ME){ nav('home'); } else { updateHeader(); showPage('login'); }
}
function loadAdminData(){
  return Promise.all([
    db.collection('users').orderBy('createdAt', 'desc').limit(500).get(),
    db.collection('orders').orderBy('date', 'desc').limit(200).get(),
    db.collection('codes').orderBy('createdAt', 'desc').limit(100).get()
  ]).then(function(r){
